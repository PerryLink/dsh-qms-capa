{
  "name": "dsh-qms-capa",
  "version": "0.1.0",
  "description": "QMS NCR ingest, batch alias resolution, impact evaluation, CAPA and 8D state.",
  "type": "module",
  "main": "./lib/plugin/index.js",
  "types": "./lib/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "docs/assets",
    "SECURITY.md",
    "PRIVACY.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "icon.svg",
    "samples",
    "TROUBLESHOOTING.md",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input/ncrs.csv",
      "prompt": "我有一批 NCR 不良记录，帮我入库去重，再查出这个批次在库存和途中命中了多少。",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "用户提供的 NCR 表（样例：samples/quickstart/input/ncrs.csv）"
      ],
      "writes": [
        "$DSH_HOME/storages/qms/"
      ],
      "network": false,
      "external": []
    },
    "capabilities": [
      "tools:register"
    ],
    "labels": []
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.4.0",
    "node": ">=24.9.0 <25"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "gate:sku08": "node scripts/gate-sku08.mjs",
    "prepublishOnly": "node scripts/check-npm-name.mjs",
    "pack:check": "npm pack --dry-run --json > pack.json && node scripts/check-pack.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qms",
    "ncr",
    "capa",
    "perrylink",
    "8d",
    "manufacturing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-qms-capa.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.3 <0.4.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.4.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "homepage": "https://perrylink.github.io/dsh-plugins/packages/dsh-qms-capa.html",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-qms-capa/issues"
  },
  "icon": "icon.svg",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
